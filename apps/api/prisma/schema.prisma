// Schema da Folha de Pagamento
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Autenticação da aplicação
// ---------------------------------------------------------------------------
enum UserRole {
  ADMIN
  RH
  VISUALIZADOR
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  role      UserRole @default(RH)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Funcionários (colaboradores) — espelham a tabela `funcionarios` do IXC
// ---------------------------------------------------------------------------
model Funcionario {
  id String @id @default(uuid())

  // Vínculo com o IXC. Único quando presente; null = cadastro só-local.
  ixcId Int? @unique @map("ixc_id")

  nome     String
  /// Como a pessoa é chamada no dia a dia ("Dão", "Neguinho"). O IXC não tem
  /// esse campo para funcionário: é preenchido aqui e serve para achar quem
  /// ninguém procura pelo nome de batismo. Espelha o `nomeFantasia` do diarista.
  apelido  String?
  cpfCnpj  String? @map("cpf_cnpj")
  email    String?
  telefone String?

  salarioBase Decimal @default(0) @map("salario_base") @db.Decimal(14, 2)

  filialId       Int?    @map("filial_id")
  idFuncao       Int?    @map("id_funcao")
  idDepartamento Int?    @map("id_departamento")
  funcao         String?
  departamento   String?

  dataAdmissao DateTime? @map("data_admissao")
  dataDemissao DateTime? @map("data_demissao")
  ativo        Boolean   @default(true)

  // Marcado pelo sync quando o fornecedor vinculado está ativo e é isento de
  // ICMS — é isso que define "é funcionário" (regra do usuário). As telas de
  // folha e a listagem só mostram quem está marcado. Ver [[project]].
  isentoIcms Boolean @default(false) @map("isento_icms")

  // Dados bancários / pagamento
  banco        String?
  agencia      String?
  conta        String?
  chavePix     String? @map("chave_pix")
  /// Tipo de PIX preferencial do cadastro do fornecedor ("Celular",
  /// "CPF/CNPJ", "E-mail"…). É o que a conta a pagar do IXC marca junto da
  /// chave; vazio = deduzir pelo formato.
  tipoChavePix String? @map("tipo_chave_pix")

  // Campos internos da aplicação (não vêm do IXC)
  observacoes String? @map("observacoes")

  // --- Configuração financeira / folha ---
  // Contratado como CLT. É só informativo: enquanto a carteira não estiver
  // assinada, a folha trata a pessoa como qualquer outra.
  clt                Boolean  @default(false) @map("clt")
  // Carteira assinada: aí sim o adiantamento já é descontado pela
  // contabilidade e NÃO é subtraído do saldo salarial aqui. Ver [[project]].
  carteiraAssinada   Boolean  @default(false) @map("carteira_assinada")
  // Só para quem tem carteira assinada: o salário oficial sai pela
  // contabilidade e a folha daqui paga este valor. Quando preenchido, é ele
  // (e não o salário base) que serve de base para o cálculo da folha.
  valorAReceberFolha Decimal? @map("valor_a_receber_folha") @db.Decimal(14, 2)
  // Opção de receber o adiantamento do dia 25
  recebeAdiantamento Boolean  @default(false) @map("recebe_adiantamento")
  // Quanto essa pessoa recebe no dia 25. Vazio = percentual da configuração
  // (40% do salário base). O que sair aqui é abatido do saldo salarial.
  valorAdiantamento  Decimal? @map("valor_adiantamento") @db.Decimal(14, 2)
  // Quanto a pessoa ganha por venda (na prática R$ 5 ou R$ 50). A comissão do
  // mês = vendas do mês × este valor, e entra no saldo salarial.
  valorPorVenda      Decimal? @map("valor_por_venda") @db.Decimal(14, 2)

  // Fornecedor vinculado no IXC (necessário para gerar contas a pagar)
  idFornecedorIxc Int? @map("id_fornecedor_ixc")
  // Cidade usada ao criar o fornecedor (senão usa a padrão da config)
  cidadeIxc       Int? @map("cidade_ixc")

  // Fidelidade total: payload cru do IXC para não perder nada
  ixcRaw       Json?     @map("ixc_raw")
  ultimoSyncAt DateTime? @map("ultimo_sync_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adiantamentos Adiantamento[]
  lancamentos   Lancamento[]
  contasPagar   ContaPagar[]
  variaveisMes  VariavelMes[]
  vales         Vale[]
  itensFerias   ItemPrevisaoFerias[]
  ferias        FeriasMarcada[]

  @@index([ativo])
  @@index([nome])
  @@index([apelido])
  @@index([isentoIcms])
  @@map("funcionarios")
}

// ---------------------------------------------------------------------------
// Adiantamentos — espelham `fl_adto_salario` do IXC
// ---------------------------------------------------------------------------
enum TipoPagamento {
  DINHEIRO // D
  CHEQUE // C
  DEPOSITO // O (outros) — mapeado conforme retorno do IXC
  OUTRO
}

model Adiantamento {
  id    String @id @default(uuid())
  ixcId Int?   @unique @map("ixc_id")

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String      @map("funcionario_id")

  descricao     String
  data          DateTime
  valor         Decimal       @db.Decimal(14, 2)
  tipoPagamento TipoPagamento @default(OUTRO) @map("tipo_pagamento")
  documento     String?
  contaId       Int?          @map("conta_id")

  ixcRaw       Json?     @map("ixc_raw")
  ultimoSyncAt DateTime? @map("ultimo_sync_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([funcionarioId])
  @@index([data])
  @@map("adiantamentos")
}

// ---------------------------------------------------------------------------
// Auditoria de sincronizações com o IXC
// ---------------------------------------------------------------------------
enum SyncStatus {
  EM_ANDAMENTO
  SUCESSO
  ERRO
}

model SyncLog {
  id          String     @id @default(uuid())
  recurso     String // ex.: "funcionarios", "adiantamentos"
  status      SyncStatus @default(EM_ANDAMENTO)
  totalLidos  Int        @default(0) @map("total_lidos")
  totalNovos  Int        @default(0) @map("total_novos")
  totalAtual  Int        @default(0) @map("total_atualizados")
  erro        String?
  iniciadoEm  DateTime   @default(now()) @map("iniciado_em")
  concluidoEm DateTime?  @map("concluido_em")

  @@index([recurso, iniciadoEm])
  @@map("sync_logs")
}

// ---------------------------------------------------------------------------
// Parametrização da integração financeira com o IXC (singleton id=1)
// ---------------------------------------------------------------------------
model ConfiguracaoFinanceira {
  id Int @id @default(1)

  // Conta de pagamento (fn_apagar.id_contas)
  contaPagamentoId Int @default(18) @map("conta_pagamento_id")
  /// A mesma coisa para quem recebe em mãos: o dinheiro sai do caixa (23), não
  /// do banco (18). É só esta conta que muda entre as duas formas de pagar.
  contaPagamentoCaixaId Int @default(23) @map("conta_pagamento_caixa_id")
  // Filial (fn_apagar.filial_id)
  filialId         Int @default(1) @map("filial_id")

  // Contas contábeis / planejamento analítico (fn_apagar.id_conta)
  contaContabilSalario      Int @default(2420) @map("conta_contabil_salario")
  contaContabilAdiantamento Int @default(2662) @map("conta_contabil_adiantamento")
  contaContabilBonus        Int @default(13916) @map("conta_contabil_bonus")
  /// Diárias. Nasce igual à de salário — confirme com a contabilidade.
  contaContabilDiaria       Int @default(2420) @map("conta_contabil_diaria")
  /// Pagamentos avulsos (mão de obra, serviço pontual, patrocínio).
  contaContabilAvulso       Int @default(324) @map("conta_contabil_avulso")

  // --- Caixa de onde sai o dinheiro pago em mãos (Financeiro > Movimentação >
  // Financeira, "CX - Werick"). ---
  /// Código do caixa no IXC. 0 = não configurado (o app procura pelo nome).
  caixaEmMaosId        Int    @default(0) @map("caixa_em_maos_id")
  /// Nome do caixa, usado para descobrir o código sozinho.
  caixaEmMaosNome      String @default("CX - Werick") @map("caixa_em_maos_nome")
  /// Tabela de contas/caixas do IXC ("" = descobre testando os nomes conhecidos).
  caixaTabelaContas    String @default("") @map("caixa_tabela_contas")
  /// Tabela dos lançamentos da movimentação financeira ("" = descobre sozinho).
  caixaTabelaMovimento String @default("") @map("caixa_tabela_movimento")

  // Cidade padrão usada ao criar fornecedores
  cidadePadraoId Int @default(1) @map("cidade_padrao_id")

  // --- Quem paga, como sai impresso no recibo assinado da diária ---
  /// Razão social de quem entrega o dinheiro. Um recibo sem dizer quem pagou
  /// não prova nada, então ele nasce com um nome e dá para acertar na tela.
  empresaNome String @default("ILNET") @map("empresa_nome")
  empresaCnpj String @default("") @map("empresa_cnpj")

  // % do salário base pago no adiantamento do dia 25, para quem recebe
  // adiantamento e não tem um lançamento de valor fixo cadastrado.
  percentualAdiantamento Int @default(40) @map("percentual_adiantamento")

  // --- Filtro que identifica funcionários no cadastro de `fornecedor` ---
  // Regra: fornecedor ativo com "Contribuinte ICMS" = Isento é funcionário.
  // Campo do ICMS no fornecedor; vazio = detecta automaticamente (qualquer
  // coluna com "icms" no nome). Preencha se a base usar um nome inesperado.
  fornecedorCampoIcms   String @default("") @map("fornecedor_campo_icms")
  // Valores que significam "Isento" nesse campo, separados por vírgula.
  // Texto contendo "isent" sempre conta; códigos numéricos variam por base.
  fornecedorIcmsIsento  String @default("I,ISENTO") @map("fornecedor_icms_isento")
  // Tabela da aba "Dados bancários" do fornecedor (banco/agência/conta/PIX).
  // Vazio = descobre sozinho testando os nomes conhecidos.
  fornecedorTabelaBanco String @default("") @map("fornecedor_tabela_banco")

  // --- Filtro que identifica diaristas no cadastro de `fornecedor` ---
  // Regra: fornecedor ativo com "Tipo de pessoa" = Estrangeiro é diarista.
  // Campo do tipo de pessoa; vazio = detecta automaticamente.
  fornecedorCampoTipoPessoa String @default("") @map("fornecedor_campo_tipo_pessoa")
  // Valores que significam "Estrangeiro", separados por vírgula. O código real
  // varia por base — confira na prévia antes de importar.
  fornecedorTipoEstrangeiro String @default("E,ESTRANGEIRO") @map("fornecedor_tipo_estrangeiro")

  // Tipo de pagamento enviado ao fn_apagar (rótulo exato usado pelo seu IXC,
  // ex.: "Pix", "Dinheiro"). A chave PIX do beneficiário vai junto no payload,
  // com o tipo da chave deduzido do formato.
  tipoPagamentoPadrao String @default("Pix") @map("tipo_pagamento_padrao")

  // --- Rádio "Tipo da chave Pix" do fn_apagar ---
  // Sem ele marcado o banco recusa o PIX. A coluna e o código de cada tipo
  // variam por base do IXC: vazio = aprender das contas que já existem lá.
  pixCampoTipoChave   String @default("") @map("pix_campo_tipo_chave")
  // Códigos por tipo, quando não há conta antiga de onde aprender.
  // Formato: "Celular=C,E-mail=E,CPF/CNPJ=D,Aleatória=A"
  pixCodigosTipoChave String @default("") @map("pix_codigos_tipo_chave")

  // O que o app já descobriu sozinho, guardado para não reaprender a cada
  // reinício nem depender das contas antigas continuarem à vista no IXC. Os
  // códigos vão se acumulando: cada tipo é aprendido uma vez e fica sabido.
  // Preenchido pelo app; o que está acima (informado à mão) vence.
  pixCampoTipoChaveAprendido    String @default("") @map("pix_campo_tipo_chave_aprendido")
  pixCodigosTipoChaveAprendidos String @default("") @map("pix_codigos_tipo_chave_aprendidos")

  // Templates de observação ({competencia} é substituído por "MM/AAAA")
  obsSalarioTemplate      String @default("saldo salarial referente ao mês {competencia}") @map("obs_salario_template")
  obsAdiantamentoTemplate String @default("adiantamento") @map("obs_adiantamento_template")
  obsBonusTemplate        String @default("bônus referente ao mês {competencia}") @map("obs_bonus_template")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("config_financeira")
}

// ---------------------------------------------------------------------------
// Lançamentos por funcionário: descontos, adiantamentos e bônus.
// competencia = null  -> FIXO (entra todo mês)
// competencia = AAAA-MM -> AVULSO (entra só naquela competência)
// ---------------------------------------------------------------------------
enum TipoLancamento {
  SALARIO
  ADIANTAMENTO
  BONUS
  DESCONTO
  AVULSO
  /// Diária de quem trabalha por dia (ver `Diarista`)
  DIARIA
}

model Lancamento {
  id String @id @default(uuid())

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String      @map("funcionario_id")

  tipo      TipoLancamento // ADIANTAMENTO | DESCONTO | BONUS
  descricao String
  valor     Decimal        @db.Decimal(14, 2)
  ativo     Boolean        @default(true)

  // null = fixo mensal; "AAAA-MM" = avulso daquela competência
  competencia String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([funcionarioId, tipo])
  @@map("lancamentos_fixos")
}

// ---------------------------------------------------------------------------
// Variáveis do mês: o que muda de competência para competência e compõe o
// saldo salarial — vendas (comissão) e horas extras.
// ---------------------------------------------------------------------------
model VariavelMes {
  id String @id @default(uuid())

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String      @map("funcionario_id")

  /// "AAAA-MM" da folha em que essas variáveis entram
  competencia String

  /// Quantas vendas a pessoa fez no mês
  vendas        Int      @default(0)
  /// Valor por venda desta competência; vazio = o do cadastro do funcionário
  valorPorVenda Decimal? @map("valor_por_venda") @db.Decimal(14, 2)

  /// Só vale para quem NÃO tem carteira assinada (quem tem recebe pela
  /// contabilidade). Entra como provento no saldo salarial.
  horasExtras Decimal @default(0) @map("horas_extras") @db.Decimal(14, 2)

  observacao String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([funcionarioId, competencia])
  @@index([competencia])
  @@map("variaveis_mes")
}

// ---------------------------------------------------------------------------
// Vales e acertos: acerto de contas entre a pessoa e a empresa, avulso ou
// parcelado. Cada um gera as parcelas de uma vez (1 por competência); a folha
// abate ou soma a parcela do mês quando `descontarDaFolha` está ligado.
// ---------------------------------------------------------------------------
enum SentidoVale {
  /// O funcionário deve à empresa (vale, compra parcelada) → sai do salário
  DESCONTO
  /// A empresa deve ao funcionário (reembolso, serviço extra) → entra no salário
  CREDITO
}

model Vale {
  id String @id @default(uuid())

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String      @map("funcionario_id")

  sentido   SentidoVale @default(DESCONTO)
  descricao String
  /// Data em que o vale foi concedido
  data      DateTime    @default(now())

  valorTotal         Decimal @map("valor_total") @db.Decimal(14, 2)
  quantidadeParcelas Int     @default(1) @map("quantidade_parcelas")
  valorParcela       Decimal @map("valor_parcela") @db.Decimal(14, 2)

  /// Desligado: fica só registrado, sem mexer na folha (acerto por fora).
  descontarDaFolha  Boolean @default(true) @map("descontar_da_folha")
  /// "AAAA-MM" da primeira parcela
  competenciaInicio String  @map("competencia_inicio")

  /// Cancelado: para de descontar e some dos saldos (histórico preservado).
  cancelado  Boolean @default(false)
  observacao String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parcelas ValeParcela[]

  @@index([funcionarioId])
  @@index([cancelado])
  @@index([sentido])
  @@map("vales")
}

model ValeParcela {
  id String @id @default(uuid())

  vale   Vale   @relation(fields: [valeId], references: [id], onDelete: Cascade)
  valeId String @map("vale_id")

  numero      Int
  competencia String
  valor       Decimal @db.Decimal(14, 2)

  /// Marcada quando a folha daquela competência é gerada (ou na mão, num
  /// acerto por fora). Parcela marcada não entra de novo no cálculo.
  descontada   Boolean   @default(false)
  descontadaEm DateTime? @map("descontada_em")

  /// Conta a pagar que consumiu a parcela. Serve para estornar a baixa se essa
  /// conta for removida ou reprovada; null = baixa manual.
  contaPagar   ContaPagar? @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)
  contaPagarId String?     @map("conta_pagar_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([valeId, numero])
  @@index([competencia])
  @@index([contaPagarId])
  @@map("vale_parcelas")
}

// ---------------------------------------------------------------------------
// Beneficiário avulso: quem recebe sem estar na folha nem receber por diária —
// mão de obra contratada, serviço pontual, patrocínio, ajuda de custo. Vira
// fornecedor no IXC, e o pagamento sai pelo banco ou em mãos, como o diarista.
// ---------------------------------------------------------------------------
model BeneficiarioAvulso {
  id String @id @default(uuid())

  nome       String
  cpfCnpj    String? @map("cpf_cnpj")
  tipoPessoa String  @default("F") @map("tipo_pessoa") // F | J
  telefone   String?
  email      String?

  chavePix     String? @map("chave_pix")
  /// Tipo da chave acima; vazio = deduzir pelo formato (igual ao diarista).
  /// Sem ele o rádio do fn_apagar fica em branco e o banco recusa o PIX.
  tipoChavePix String? @map("tipo_chave_pix")

  /// Quanto ganha por venda: cliente da empresa também vende e comissiona.
  /// Só sugere o valor no pagamento.
  valorPorVenda Decimal? @map("valor_por_venda") @db.Decimal(14, 2)

  /// Forma habitual de pagar essa pessoa (dá para mudar em cada pagamento)
  formaPagamento FormaPagamento @default(IXC) @map("forma_pagamento")

  observacoes String?
  ativo       Boolean @default(true)

  idFornecedorIxc     Int?    @map("id_fornecedor_ixc")
  cidadeIxc           Int?    @map("cidade_ixc")
  /// Ligado quando a pessoa, avisada de que já existe fornecedor com aquele
  /// CPF/CNPJ no IXC, escolheu criar um novo assim mesmo. Sem isto, o app
  /// reaproveita o cadastro existente — que é o certo na maioria das vezes,
  /// porque é lá que estão os dados bancários.
  fornecedorNovoNoIxc Boolean @default(false) @map("fornecedor_novo_no_ixc")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contasPagar ContaPagar[]
  pagamentos  PagamentoAvulso[]

  @@index([ativo])
  @@index([nome])
  @@map("beneficiarios_avulsos")
}

/// Um pagamento avulso feito (ou a fazer): quanto, por quê e por onde saiu.
/// Espelha `Diaria` de propósito — os dois caminhos do dinheiro são os mesmos.
model PagamentoAvulso {
  id String @id @default(uuid())

  beneficiario   BeneficiarioAvulso @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  beneficiarioId String             @map("beneficiario_id")

  data          DateTime
  /// Total pago = serviço + comissão de venda + extra, editável na tela
  valor         Decimal  @db.Decimal(14, 2)
  /// O que foi feito — vira a observação da conta a pagar no IXC
  descricao     String
  /// fn_apagar.id_conta deste pagamento (padrão: o da configuração)
  contaContabil Int      @map("conta_contabil")

  // --- Comissão de venda e o serviço por fora (ver `Diaria`) ---
  vendas         Int      @default(0)
  valorPorVenda  Decimal? @map("valor_por_venda") @db.Decimal(14, 2)
  comissaoVendas Decimal  @default(0) @map("comissao_vendas") @db.Decimal(14, 2)
  valorExtra     Decimal  @default(0) @map("valor_extra") @db.Decimal(14, 2)
  descricaoExtra String?  @map("descricao_extra")

  forma FormaPagamento

  /// Conta a pagar gerada no IXC (só na forma IXC)
  contaPagar   ContaPagar? @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)
  contaPagarId String?     @unique @map("conta_pagar_id")

  // --- Pagamento em mãos: a saída no caixa do IXC ---
  caixaIxc        Int?      @map("caixa_ixc")
  idLancamentoIxc Int?      @map("id_lancamento_ixc")
  lancadoEm       DateTime? @map("lancado_em")
  lancadoManual   Boolean   @default(false) @map("lancado_manual")
  /// Por que o lançamento no caixa não saiu (null = sem pendência)
  erroIxc         String?   @map("erro_ixc")

  criadoPor String?  @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([beneficiarioId])
  @@index([data])
  @@map("pagamentos_avulsos")
}

// ---------------------------------------------------------------------------
// Diaristas: quem trabalha por dia e recebe por diária, sem vínculo de folha.
// O pagamento sai pelo IXC (conta a pagar, como qualquer beneficiário) ou em
// mãos — e aí o dinheiro sai do caixa configurado (ver `caixaEmMaosId`).
// ---------------------------------------------------------------------------
/// Por onde o dinheiro sai. Vale para diária e para pagamento avulso — é a
/// mesma escolha, e os dois caminhos são os mesmos.
enum FormaPagamento {
  /// Conta a pagar no IXC: auditoria e pagamento pelo banco
  IXC
  /// Dinheiro entregue na hora, descontado do caixa
  EM_MAOS
}

model Diarista {
  id String @id @default(uuid())

  /// Razão social — é o nome que vai para a conta a pagar no IXC
  nome         String
  /// Como a pessoa é conhecida no dia a dia ("Deda pedreiro"); também é buscável
  nomeFantasia String? @map("nome_fantasia")
  cpfCnpj      String? @map("cpf_cnpj")
  telefone     String?

  /// Dados de pagamento, vindos da aba "Dados bancários" do fornecedor no IXC
  banco        String?
  agencia      String?
  conta        String?
  chavePix     String? @map("chave_pix")
  /// Tipo da chave acima; vazio = deduzir pelo formato (igual ao funcionário)
  tipoChavePix String? @map("tipo_chave_pix")

  /// Quanto essa pessoa cobra por dia. Só sugere o valor no pagamento.
  valorDiaria    Decimal?       @map("valor_diaria") @db.Decimal(14, 2)
  /// Quanto ganha por venda: diarista também é vendedor externo. Igual ao
  /// campo do funcionário, só sugere o valor no pagamento.
  valorPorVenda  Decimal?       @map("valor_por_venda") @db.Decimal(14, 2)
  /// Forma habitual de pagar essa pessoa (dá para mudar em cada diária)
  formaPagamento FormaPagamento @default(IXC) @map("forma_pagamento")

  observacoes String?
  ativo       Boolean @default(true)

  /// Fornecedor no IXC, criado na primeira diária paga pelo IXC
  idFornecedorIxc Int?    @map("id_fornecedor_ixc")
  cidadeIxc       Int?    @map("cidade_ixc")
  /// Veio da importação de fornecedores "Estrangeiro", não do cadastro à mão
  importadoDoIxc  Boolean @default(false) @map("importado_do_ixc")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  diarias     Diaria[]
  contasPagar ContaPagar[]

  @@index([ativo])
  @@index([nome])
  @@index([nomeFantasia])
  @@map("diaristas")
}

/// Um pagamento ao diarista: os dias trabalhados, a comissão das vendas que ele
/// fechou e o serviço por fora — tudo somado num pagamento só, que é como a
/// pessoa recebe. Cada parte fica gravada para o gasto poder ser aberto depois.
model Diaria {
  id String @id @default(uuid())

  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)
  diaristaId String   @map("diarista_id")

  /// Dia trabalhado (ou o primeiro, quando são vários)
  data        DateTime
  quantidade  Decimal  @default(1) @db.Decimal(8, 2)
  valorDiaria Decimal  @map("valor_diaria") @db.Decimal(14, 2)
  /// Total pago = diárias + comissão de venda + extra, editável na tela
  valor       Decimal  @db.Decimal(14, 2)
  descricao   String

  // --- Vendas: o diarista também é vendedor externo ---
  /// Quantas vendas entraram neste pagamento
  vendas         Int      @default(0)
  /// Valor de cada venda aqui; vazio = o do cadastro do diarista
  valorPorVenda  Decimal? @map("valor_por_venda") @db.Decimal(14, 2)
  /// vendas × valorPorVenda, congelado: o gasto com vendas de um mês fechado
  /// não pode mudar porque alguém corrigiu o cadastro depois.
  comissaoVendas Decimal  @default(0) @map("comissao_vendas") @db.Decimal(14, 2)
  /// Serviço feito por fora que rendeu um troco a mais no mesmo pagamento
  valorExtra     Decimal  @default(0) @map("valor_extra") @db.Decimal(14, 2)
  descricaoExtra String?  @map("descricao_extra")

  forma FormaPagamento

  /// Conta a pagar gerada no IXC (só na forma IXC)
  contaPagar   ContaPagar? @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)
  contaPagarId String?     @unique @map("conta_pagar_id")

  // --- Pagamento em mãos: a saída no caixa do IXC ---
  /// Caixa de onde o dinheiro saiu
  caixaIxc        Int?      @map("caixa_ixc")
  /// Lançamento criado na movimentação financeira do IXC
  idLancamentoIxc Int?      @map("id_lancamento_ixc")
  lancadoEm       DateTime? @map("lancado_em")
  /// Lançado no IXC à mão por alguém (o app não conseguiu)
  lancadoManual   Boolean   @default(false) @map("lancado_manual")
  /// Por que o lançamento no caixa não saiu (null = sem pendência)
  erroIxc         String?   @map("erro_ixc")

  criadoPor String?  @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Recibo assinado por quem recebeu (só faz sentido no pagamento em mãos)
  assinatura AssinaturaDiaria?

  @@index([diaristaId])
  @@index([data])
  @@map("diarias")
}

/// ---------------------------------------------------------------------------
/// Recibo assinado de uma diária paga em mãos.
///
/// Dinheiro entregue na mão não deixa rastro em banco nenhum: o comprovante é a
/// assinatura de quem recebeu. Quem paga gera um link, a pessoa desenha o nome
/// com o dedo — no celular de quem pagou ou no dela, de onde estiver — e o
/// recibo fica guardado aqui.
///
/// Os valores e nomes são copiados para cá quando o link é gerado, em vez de
/// serem lidos do cadastro na hora de imprimir — e é exatamente esse texto que
/// a pessoa lê antes de assinar. Um recibo é o retrato do que ela concordou ter
/// recebido: se amanhã alguém corrigir o cadastro dela ou o valor da diária, o
/// papel que ela assinou não pode mudar junto.
/// ---------------------------------------------------------------------------
/// Como a assinatura foi feita. Não é detalhe de tela: um recibo que aparenta
/// punho próprio sem ser não vale mais que um sem assinatura nenhuma — vale
/// menos, porque engana quem o lê. Por isso o modo é gravado e sai impresso.
enum ModoAssinatura {
  /// Desenhada com o dedo por quem recebeu
  DESENHADA
  /// Gerada a partir do nome, a pedido de quem não assina de próprio punho
  DIGITADA
}

model AssinaturaDiaria {
  id String @id @default(uuid())

  diaria   Diaria @relation(fields: [diariaId], references: [id], onDelete: Cascade)
  diariaId String @unique @map("diaria_id")

  /// Segredo que vai na URL pública. Quem tem o link assina — por isso ele é
  /// sorteado grande, morre ao ser usado e não é reaproveitado.
  token    String   @unique
  expiraEm DateTime @map("expira_em")

  /// PNG da assinatura, em data URL. Vazio até alguém assinar.
  assinaturaPng String?   @map("assinatura_png")
  assinadoEm    DateTime? @map("assinado_em")
  /// Desenhada com o dedo, ou gerada a partir do nome de quem não escreve
  modo          ModoAssinatura @default(DESENHADA)

  // --- O retrato do pagamento, congelado na hora de assinar ---
  /// Nome que a pessoa confirmou ser o dela ao assinar
  nomeAssinante String? @map("nome_assinante")
  cpfAssinante  String? @map("cpf_assinante")
  /// Valor, serviço e data como estavam no recibo que ela viu
  valor         Decimal @db.Decimal(14, 2)
  descricao     String
  dataDiaria    DateTime @map("data_diaria")
  detalhamento  String?
  /// Quem pagou, como aparece no cabeçalho do recibo
  empresaNome   String  @map("empresa_nome")
  empresaCnpj   String? @map("empresa_cnpj")

  // --- De onde veio a assinatura, para o caso de alguém contestar ---
  ip        String?
  userAgent String? @map("user_agent")

  /// Quem gerou o link
  criadoPor String?  @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("assinaturas_diaria")
}

// ---------------------------------------------------------------------------
// Conta a pagar (espelho local do fn_apagar do IXC) com o fluxo de aprovação
// ---------------------------------------------------------------------------
enum StatusContaPagar {
  RASCUNHO // criada localmente, ainda não enviada ao IXC
  AGUARDANDO_APROVACAO // salva no IXC (fn_apagar criado), pendente auditoria
  APROVADO // auditoria aprovou (fn_apagar_auditoria = A)
  REPROVADO // auditoria reprovou (R)
  AGUARDANDO_PAGAMENTO // aprovada; aguardando "pagar com ModoBank" no IXC
  PAGO // retorno do banco: paga
  CANCELADO
  ERRO // falha ao enviar/processar no IXC
}

model ContaPagar {
  id String @id @default(uuid())

  competencia String?        @map("competencia") // "AAAA-MM" (null p/ avulso sem competência)
  tipo        TipoLancamento // SALARIO | ADIANTAMENTO | BONUS | AVULSO

  // Beneficiário: funcionário OU avulso (exatamente um preenchido)
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  funcionarioId String?      @map("funcionario_id")

  beneficiarioAvulso   BeneficiarioAvulso? @relation(fields: [beneficiarioAvulsoId], references: [id], onDelete: SetNull)
  beneficiarioAvulsoId String?             @map("beneficiario_avulso_id")

  diarista   Diarista? @relation(fields: [diaristaId], references: [id], onDelete: SetNull)
  diaristaId String?   @map("diarista_id")

  // Snapshot do beneficiário (não muda se o cadastro mudar depois)
  beneficiarioNome String @map("beneficiario_nome")
  idFornecedorIxc  Int?   @map("id_fornecedor_ixc")

  valor            Decimal  @db.Decimal(14, 2)

  // --- Quanto deste pagamento era comissão de venda ---
  // Só o salário traz isso preenchido: a comissão do mês entra dentro dele, e
  // sem gravar aqui não há como responder quanto o mês custou em venda. Fica
  // congelado no momento em que a folha é gerada — refazer a conta depois,
  // pelas vendas lançadas, dá um número que ninguém pagou.
  vendas           Int      @default(0)
  comissaoVendas   Decimal  @default(0) @map("comissao_vendas") @db.Decimal(14, 2)

  contaContabil    Int      @map("conta_contabil") // fn_apagar.id_conta
  contaPagamento   Int      @map("conta_pagamento") // fn_apagar.id_contas
  /// fn_apagar.tipo_pagamento desta conta; null = o padrão da configuração
  tipoPagamentoIxc String?  @map("tipo_pagamento_ixc")
  filialId         Int      @map("filial_id")
  dataEmissao      DateTime @map("data_emissao")
  dataVencimento   DateTime @map("data_vencimento")
  observacao       String

  status StatusContaPagar @default(RASCUNHO)
  erro   String?

  // Referências no IXC
  idFnApagarIxc Int?  @map("id_fn_apagar_ixc")
  ixcStatusRaw  Json? @map("ixc_status_raw")

  // Auditoria (aprovação)
  aprovadoPor     String?   @map("aprovado_por")
  aprovadoEm      DateTime? @map("aprovado_em")
  motivoAuditoria String?   @map("motivo_auditoria")

  // Pagamento
  pagoEm DateTime? @map("pago_em")

  criadoPor String?  @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Parcelas de vale abatidas (ou pagas) por esta conta
  parcelasVale    ValeParcela[]
  /// Diária que gerou esta conta, quando foi paga pelo IXC
  diaria          Diaria?
  /// Pagamento avulso que gerou esta conta, quando foi pago pelo IXC
  pagamentoAvulso PagamentoAvulso?

  @@index([status])
  @@index([competencia])
  @@index([funcionarioId])
  @@index([diaristaId])
  @@index([idFnApagarIxc])
  @@map("contas_pagar")
}

// ---------------------------------------------------------------------------
// Guias de imposto que a contabilidade manda todo mês (DARF, FGTS, DAS e o
// DARE do ICMS). Lidas do PDF, conferidas na tela e só então gravadas.
// ---------------------------------------------------------------------------
enum TipoGuia {
  /// DARF previdenciário (INSS)
  DARF_INSS
  /// Guia do FGTS Digital
  FGTS
  /// DAS do Simples Nacional
  DAS_SIMPLES
  /// DARE estadual — o ICMS (na prática, o DIFAL)
  DARE_ICMS
  OUTRA
}

/// O que o item representa no bolso da empresa. Somar tudo junto mente: ver
/// `guias.parse.ts`.
enum ClasseTributo {
  /// Custo da empresa com pessoal: FGTS e a parte patronal do INSS
  FOLHA_PATRONAL
  /// Retido de quem trabalha e só repassado: INSS do segurado, consignado
  FOLHA_RETIDO
  /// Tributo sobre faturamento: IRPJ, CSLL, COFINS, PIS, ICMS
  FATURAMENTO
}

model Guia {
  id String @id @default(uuid())

  tipo        TipoGuia
  /// Período de apuração ("AAAA-MM") — o mês a que o imposto se refere
  competencia String
  vencimento  DateTime
  valorTotal  Decimal  @map("valor_total") @db.Decimal(14, 2)

  numeroDocumento String? @map("numero_documento")
  cnpj            String?
  razaoSocial     String? @map("razao_social")
  /// Quantos trabalhadores a guia do FGTS declarou
  trabalhadores   Int?

  arquivoNome   String  @map("arquivo_nome")
  /// Texto extraído do PDF, para reconferir a leitura sem o arquivo original
  textoOriginal String? @map("texto_original")

  criadoPor String?  @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itens GuiaItem[]

  /// O mesmo documento não entra duas vezes — senão o gráfico conta em dobro
  @@unique([tipo, competencia, numeroDocumento])
  @@index([competencia])
  @@map("guias")
}

// ---------------------------------------------------------------------------
// Férias: a "Previsão de Férias" que a contabilidade manda todo mês, lida do
// PDF, e o registro de quem já foi mandado para férias.
// ---------------------------------------------------------------------------

/// Uma remessa da contabilidade. Cada envio é uma foto do dia em que foi
/// tirada: os dias que faltam são recontados aqui a partir da data limite, mas
/// o próprio direito (quem fechou 12 meses) vem do que ela apurou.
model PrevisaoFerias {
  id String @id @default(uuid())

  /// Dia a que o relatório se refere ("Período: dd/mm/aaaa" no cabeçalho).
  /// Único: subir o mesmo relatório de novo substitui, não duplica a fila.
  dataRelatorio DateTime @unique @map("data_relatorio")

  empresa     String?
  cnpj        String?
  /// "Nº de Meses Limite" do cabeçalho (11 no relatório da Fortes).
  mesesLimite Int?    @map("meses_limite")

  arquivoNome String @map("arquivo_nome")

  criadoPor String?  @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")

  itens ItemPrevisaoFerias[]

  @@map("previsoes_ferias")
}

/// Uma pessoa dentro da previsão, com as datas que decidem a vez dela.
model ItemPrevisaoFerias {
  id String @id @default(uuid())

  previsao   PrevisaoFerias @relation(fields: [previsaoId], references: [id], onDelete: Cascade)
  previsaoId String         @map("previsao_id")

  /// Posição no PDF, de cima para baixo
  ordem  Int
  /// Matrícula na contabilidade ("000055") — é o que identifica a pessoa entre
  /// uma remessa e outra, já que o PDF não traz CPF.
  codigo String
  nome   String
  cargo  String?

  admissao      DateTime?
  /// Os 12 meses trabalhados que dão direito às férias
  periodoInicio DateTime  @map("periodo_inicio")
  periodoFim    DateTime  @map("periodo_fim")
  /// Último dia em que as férias podem começar sem virar dobro (art. 137 CLT)
  dataLimite    DateTime  @map("data_limite")

  diasDireito    Decimal  @default(30) @map("dias_direito") @db.Decimal(5, 1)
  /// Dias acumulados na data do relatório (2,5 por mês trabalhado)
  diasAcumulados Decimal? @map("dias_acumulados") @db.Decimal(5, 1)
  diasRestantes  Decimal? @map("dias_restantes") @db.Decimal(5, 1)

  /// Cadastro daqui, quando o nome casou. Serve para abrir a ficha da pessoa —
  /// o PDF vem da contabilidade e nem todo mundo dele está cadastrado aqui.
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  funcionarioId String?      @map("funcionario_id")

  @@index([previsaoId])
  @@index([dataLimite])
  @@map("itens_previsao_ferias")
}

/// Alguém mandado para férias. Registra aqui quem está fora e até quando; não
/// paga nada nem mexe na folha — o pagamento das férias é da contabilidade.
model FeriasMarcada {
  id String @id @default(uuid())

  /// Matrícula e nome como vieram do relatório, porque a pessoa pode não ter
  /// cadastro aqui e o registro não pode depender disso.
  codigo String
  nome   String

  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  funcionarioId String?      @map("funcionario_id")

  inicio DateTime
  fim    DateTime
  dias   Int      @default(30)

  /// Período aquisitivo que estas férias quitam. É ele que tira a pessoa da
  /// fila enquanto a contabilidade não manda a previsão nova — o mesmo período
  /// não é concedido duas vezes.
  periodoInicio DateTime @map("periodo_inicio")
  periodoFim    DateTime @map("periodo_fim")

  observacao String?

  criadoPor String?  @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([codigo, periodoFim])
  @@index([inicio])
  @@map("ferias_marcadas")
}

model GuiaItem {
  id String @id @default(uuid())

  guia   Guia   @relation(fields: [guiaId], references: [id], onDelete: Cascade)
  guiaId String @map("guia_id")

  /// Código de receita; o FGTS não tem
  codigo      String?
  denominacao String
  valor       Decimal       @db.Decimal(14, 2)
  classe      ClasseTributo

  @@index([guiaId])
  @@map("guia_itens")
}
